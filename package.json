{
  "name": "team-crm",
  "version": "1.0.0",
  "private": "true",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @team-crm/api",
    "swagger:api": "npm run swagger -w @team-crm/api",
    "dev:web": "npm run dev -w @team-crm/web",
    "postinstall": "prisma skills sync || exit 0",
    "db:generate": "npm run db:generate -w packages/db",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:diff": "prisma db diff --from-schema-datamodel packages/db/prisma/schema.prisma --to-schema-datasource packages/db/prisma/schema.prisma --script",
    "db:push": "prisma db push --schema=packages/db/prisma/schema.prisma",
    "socket:api": "npm run socket -w @team-crm/api",
    "dev" : "concurrently \"npm run dev:api\"  \"npm run dev:web\"",
    "db" : "concurrently \"npm run db:generate\" \"npm run db:push\" \"npm run db:migrate\" "
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prisma": "^7.10.0",
    "prisma-json-schema-generator": "^5.1.5",
    "swagger-autogen": "^2.23.7",
    "swagger-themes": "^1.4.3",
    "swagger-ui-express": "^5.0.1"
  }
}
